---
import Base from "../../layouts/Base.astro";
import { projects } from "../../lib/projects";
---
<Base title="projects — Aditya Bhosale" description="projects — Aditya Bhosale">
  <style is:global>
    .project-list { margin-top: 40px; }

    .project {
      padding: 28px 0;
      border-bottom: 1px solid var(--rule);
    }

    .project:last-child { border-bottom: none; }

    .project h2 {
      font-size: 21px;
      font-weight: 500;
      margin-bottom: 6px;
      letter-spacing: -0.005em;
    }

    .project h2 a {
      color: var(--ink);
      text-decoration: none;
      transition: color 0.15s ease;
    }

    .project h2 a:hover { color: var(--accent-hover); }

    .project p {
      color: var(--ink-muted);
      font-size: 18px;
      line-height: 1.55;
      margin-bottom: 0;
    }

    .project-meta {
      font-style: italic;
      color: var(--ink-faint);
      font-size: 16px;
      margin-bottom: 10px;
    }

    .project h2 .arrow {
      display: inline-block;
      margin-left: 7px;
      font-size: 0.72em;
      color: var(--ink-faint);
      vertical-align: 2px;
      transition: transform 0.15s ease, color 0.15s ease;
    }

    .project h2 a:hover .arrow {
      transform: translate(2px, -2px);
      color: var(--accent-hover);
    }
  </style>

  <a href="/" class="back-link">← back</a>
  <h1>recent projects</h1>

  <div class="project-list">
    {projects.map((p) => (
      <article class="project">
        <h2><a href={`/projects/${p.slug}`}>{p.title}<span class="arrow">↗</span></a></h2>
        <div class="project-meta">{p.date} · {p.stack}</div>
        <p>{p.blurb}</p>
      </article>
    ))}
  </div>
</Base>
