---
import Base from "../../layouts/Base.astro";

const analyses = [
  {
    href: '/analyses/alternative-data-moat-decay',
    title: 'Alternative-data moats are decaying assets',
    subtitle: 'Visualizing competitive-moat decay across a cluster of emerging-markets, consumer-facing financial services & industrials companies',
    date: 'May 2026',
  },
];
---
<Base title="Analyses — Aditya Bhosale" description="Analyses — Aditya Bhosale">
  <style is:global>
    .analyses-intro {
      color: var(--ink-muted);
      margin: 20px 0 44px;
    }

    .analysis-item {
      padding: 24px 0;
      border-bottom: 1px solid var(--rule);
    }

    .analysis-item:first-of-type { border-top: 1px solid var(--rule); }

    .analysis-item > a {
      text-decoration: none;
      color: var(--ink);
      display: block;
    }

    .analysis-item h2 {
      font-size: 21px;
      font-weight: 500;
      margin-bottom: 6px;
      letter-spacing: -0.005em;
      transition: color 0.15s ease;
    }

    .analysis-item > a:hover h2 { color: var(--accent-hover); }

    .analysis-item .subtitle {
      color: var(--ink-muted);
      font-style: italic;
      font-size: 18px;
      line-height: 1.5;
      margin-bottom: 6px;
    }

    .analysis-item .date {
      color: var(--ink-faint);
      font-size: 16px;
    }
  </style>

  <a href="/" class="back-link">← back</a>
  <h1>Analyses</h1>

  <p class="analyses-intro">
    Ongoing long-form analytical work. Reach out at
    <a href="mailto:adityanb@sas.upenn.edu">adityanb@sas.upenn.edu</a>.
  </p>

  {analyses.map((a) => (
    <div class="analysis-item">
      <a href={a.href}>
        <h2>{a.title}</h2>
        <p class="subtitle">{a.subtitle}</p>
        <div class="date">{a.date}</div>
      </a>
    </div>
  ))}
</Base>
