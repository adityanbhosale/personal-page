---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";

const allPosts = await getCollection("thoughts");

// Group by topic
const byTopic: Record<string, typeof allPosts> = {};
for (const post of allPosts) {
  const t = post.data.topic;
  if (!byTopic[t]) byTopic[t] = [];
  byTopic[t].push(post);
}

// Sort posts within each topic by date, newest first
for (const topic of Object.keys(byTopic)) {
  byTopic[topic].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
}

const topics = Object.keys(byTopic).sort();

// Render each post's Markdown body to HTML, and extract preview text
const postsWithContent = await Promise.all(
  allPosts.map(async (post) => {
    const { Content } = await render(post);

    const firstPara = post.body
      ?.split(/\n\s*\n/)
      .map((p) => p.trim())
      .find((p) => p.length > 0) ?? "";

    const cleaned = firstPara
      .replace(/`([^`]+)`/g, "$1")
      .replace(/\*\*([^*]+)\*\*/g, "$1")
      .replace(/\*([^*]+)\*/g, "$1")
      .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
      .replace(/^#+\s*/, "")
      .replace(/\s+/g, " ")
      .trim();

    const preview = cleaned.length > 120
      ? cleaned.slice(0, 120).replace(/\s+\S*$/, "") + "…"
      : cleaned;

    return { post, Content, preview };
  })
);

const contentMap = new Map(postsWithContent.map(({ post, Content, preview }) => [post.id, { Content, preview }]));
---
<Base title="working notes — Aditya Bhosale" description="working notes — Aditya Bhosale">
  <style is:global>
    h2.topic {
      font-size: 21px;
      font-weight: 500;
      color: var(--ink-muted);
      font-style: italic;
      margin-top: 64px;
      margin-bottom: 18px;
      letter-spacing: 0;
    }

    section:first-of-type h2.topic { margin-top: 44px; }

    details.entry {
      border-bottom: 1px solid var(--rule);
      padding: 20px 0;
    }

    details.entry:last-child { border-bottom: none; }

    details.entry > summary {
      cursor: pointer;
      list-style: none;
      position: relative;
      padding-right: 84px;
      transition: opacity 0.15s ease;
    }

    details.entry > summary::-webkit-details-marker { display: none; }
    details.entry > summary:hover .entry-title { color: var(--accent-hover); }

    .entry-date {
      font-style: italic;
      color: var(--ink-faint);
      font-size: 16px;
      margin-bottom: 2px;
    }

    .entry-title {
      font-size: 20px;
      font-weight: 500;
      display: block;
      margin-bottom: 4px;
      transition: color 0.15s ease;
    }

    .entry-preview {
      color: var(--ink-muted);
      font-size: 18px;
      line-height: 1.55;
    }

    .expand-cue {
      position: absolute;
      right: 0;
      top: 4px;
      color: var(--ink-faint);
      font-size: 15px;
      font-style: italic;
    }

    details.entry[open] .expand-cue::after { content: "collapse ↑"; }
    details.entry:not([open]) .expand-cue::after { content: "expand ↓"; }
    details.entry > summary:hover .expand-cue { color: var(--accent-hover); }

    details.entry[open] > summary .entry-preview { display: none; }
    details.entry[open] > summary { margin-bottom: 16px; }

    /* Rendered markdown */
    .entry-body { font-size: 19px; }
    .entry-body p { margin-bottom: 1em; }
    .entry-body :last-child { margin-bottom: 0; }

    .entry-body h1,
    .entry-body h2,
    .entry-body h3,
    .entry-body h4 {
      font-size: 19px;
      font-weight: 600;
      margin: 1.4em 0 0.5em;
      letter-spacing: 0;
    }

    .entry-body ul,
    .entry-body ol {
      margin: 0 0 1em 1.2em;
    }

    .entry-body li { margin-bottom: 0.35em; }

    .entry-body blockquote {
      border-left: 1px solid var(--rule);
      padding-left: 18px;
      color: var(--ink-muted);
      font-style: italic;
      margin: 0 0 1em;
    }

    .entry-body code {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.85em;
      background: var(--bg-raised);
      padding: 1px 5px;
      border-radius: 2px;
      color: var(--ink);
    }

    .entry-body pre {
      background: var(--bg-raised);
      padding: 16px 18px;
      border-radius: 3px;
      overflow-x: auto;
      margin: 0 0 1em;
    }

    .entry-body pre code { background: none; padding: 0; }

    .entry-body hr { margin: 1.5em 0; }

    .entry-body img { max-width: 100%; height: auto; }

    .entry-body table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.9em;
      margin: 0 0 1em;
      display: block;
      overflow-x: auto;
    }

    .entry-body th,
    .entry-body td {
      border-bottom: 1px solid var(--rule);
      padding: 7px 10px 7px 0;
      text-align: left;
    }

    .empty-state {
      color: var(--ink-muted);
      font-style: italic;
    }

    @media (max-width: 600px) {
      details.entry > summary { padding-right: 0; }
      .expand-cue { position: static; display: block; margin-top: 6px; }
      h2.topic { margin-top: 48px; }
    }
  </style>

  <a href="/" class="back-link">← back</a>
  <h1>working notes</h1>

  {topics.length === 0 && (
    <p class="empty-state">nothing here yet.</p>
  )}

  {topics.map((topic) => (
    <section>
      <h2 class="topic">{topic}</h2>
      {byTopic[topic].map((post) => {
        const entry = contentMap.get(post.id)!;
        return (
          <details class="entry">
            <summary>
              <div class="entry-date">
                {post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
              </div>
              <span class="entry-title">{post.data.title}</span>
              <span class="entry-preview">{entry.preview}</span>
              <span class="expand-cue"></span>
            </summary>
            <div class="entry-body">
              <entry.Content />
            </div>
          </details>
        );
      })}
    </section>
  ))}
</Base>
